{
  "name": "kunwaeyan-scam-check",
  "version": "1.0.0",
  "private": true,
  "description": "كن واعياً (Be Aware) Scam Shield: finds fake websites copying UAE organisations early, and flags risky links in search results, messages and WhatsApp. Free, private, Arabic and English.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build:extension": "node scripts/build-extension.mjs",
    "test": "node --test test/url-analyzer.test.js test/local-analysis.test.js test/link-model.test.js test/watch.test.js",
    "train": "node scripts/train-model.mjs",
    "train:urls": "node scripts/train-url-model.mjs",
    "evaluate": "node scripts/evaluate-links.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1"
  },
  "license": "UNLICENSED"
}
