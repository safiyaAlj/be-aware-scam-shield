# Copy to .env and fill in. Never commit .env.

PORT=8080

# Optional password for the whole site (browser asks for it). Remove to open the site to everyone.
SITE_PASSWORD=
SITE_USER=be-aware
# Number of reverse proxies in front of the app (for correct client IPs in rate limiting)
TRUST_PROXY_HOPS=1

# --- Message analysis ---
# "local" = free model on this server (text only). "claude" = Claude AI (paid, needs the key below).
# Leave empty to use Claude when ANTHROPIC_API_KEY is set, otherwise the local model.
ANALYSIS_ENGINE=

# --- AI analysis (Anthropic API, optional and paid) ---
ANTHROPIC_API_KEY=
# Default is claude-opus-5-5. For high public volume you can choose a cheaper model, e.g. claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high
CLAUDE_EFFORT=medium

# --- Public phishing lists (free, downloaded to this server) ---
# Set to off to disable. Refresh interval in hours.
PHISH_LISTS=
PHISH_LIST_REFRESH_HOURS=6

# --- Fake sites watch (public page at /watch) and website age ---
# WATCH=off disables the watch. WATCH_DAYS = past days of new domains to scan on first run.
WATCH=
WATCH_DAYS=14
# Password for changing a site's status on the dashboard (header x-watch-token). Empty = only from this machine.
WATCH_TOKEN=
# DOMAIN_AGE=off stops registration-date lookups (RDAP) for links.
DOMAIN_AGE=

# --- Google Safe Browsing (https://console.cloud.google.com -> enable "Safe Browsing API" -> API key) ---
GOOGLE_SAFE_BROWSING_KEY=

# --- Browser extension ---
# Server address baked into the extension at build time
EXTENSION_API_BASE=https://YOUR-SERVER-DOMAIN
# Extension origins allowed to call the API (find the ID after publishing), comma-separated
EXTENSION_ORIGINS=chrome-extension://YOUR_CHROME_EXTENSION_ID,extension://YOUR_EDGE_EXTENSION_ID

# --- Trusted apps calling the API (optional) ---
# Comma-separated keys, 16+ characters each, sent as the x-api-key header (for example by a chat bot).
TRUSTED_API_KEYS=
